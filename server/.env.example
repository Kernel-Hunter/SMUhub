# Copy this file to .env and adjust the values. Never commit .env.

# Local MongoDB (the database is created on first write).
# To use the shared Atlas database, ask Nour for your personal MONGODB_URI (never commit it).
MONGODB_URI=mongodb://localhost:27017/SMUhub

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# How long a login lasts, in days.
SESSION_DAYS=7

# Comma-separated list of SMU email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=smu.tn,medtech.tn,msb.tn

# Origin of the web client (CORS + cookies).
CLIENT_URL=http://localhost:5173

PORT=4000

# Sign-up, resend, forgot-password, verify and reset requests allowed per IP per 15 minutes (each group).
AUTH_RATE_LIMIT=50

# Outgoing mail for verification and password reset codes (optional in development).
# Without SMTP_URL the code is printed in the server console in development, and sign-up answers 503 in production.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=SMUhub <no-reply@smu.tn>

# Password given to the test students by `npm run seed` (8 to 128 characters).
# Re-running the seed resets their password to this value.
SEED_PASSWORD=ChangeMe-Seed2026!

# development | production | test  (production turns on Secure cookies)
NODE_ENV=development
