# Copy this file to .env and adjust the values. Never commit .env.

# Local MongoDB (the database is created on first write).
MONGODB_URI=mongodb://localhost:27017/SMUhub

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# How long a login lasts, in days.
SESSION_DAYS=7

# Comma-separated list of SMU email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=smu.tn,medtech.tn,msb.tn

# Origin of the web client (CORS + cookies).
CLIENT_URL=http://localhost:5173

PORT=4000

# development | production | test  (production turns on Secure cookies)
NODE_ENV=development
