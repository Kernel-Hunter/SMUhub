# Copy to .env.local if you need to change something. Defaults work for local development.

# Leave empty to call /api on the same origin (Vite proxies it to the server in dev).
# Set it only when the API is on another origin, e.g. https://api.smuhub.example
VITE_API_URL=

# Where the dev proxy sends /api requests.
API_PROXY_TARGET=http://localhost:4000

# Mirrors ALLOWED_EMAIL_DOMAINS in server/.env (client-side hint only, the server decides).
VITE_ALLOWED_EMAIL_DOMAINS=smu.tn,medtech.tn,msb.tn
